# ============================================
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your API keys.
# You only need the keys for the services you plan to use.

# --- OpenRouter API Key ---
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1

# --- OpenAI (Required for OpenAI API calls, unless using Ollama) ---
OPENAI_API_KEY=

# --- Gemini (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- Groq (free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=

# --- Anthropic (Required for Claude API calls) ---
ANTHROPIC_API_KEY=

# --- Azure OpenAI (Optional — enterprise) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# --- Hugging Face (Optional — free tier: https://huggingface.co/settings/tokens) ---
HUGGINGFACE_API_KEY=

# ============================================
# Cost Control Settings
# ============================================
# Set USE_OLLAMA=true to run all notebooks with free local models
USE_OLLAMA=false

# Set USE_SMALL_MODEL=true to use gpt-4o-mini (10x cheaper than gpt-4o)
USE_SMALL_MODEL=false

# Ollama base URL (change if running remotely)
OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# Provider Selection
# ============================================
# Which API provider the code use by default.
# Options: openai, anthropic, gemini, groq, openrouter
LLM_PROVIDER=openrouter

# Model names (only used when the matching provider is selected)
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=openai/gpt-4o-mini

# ============================================
# Settings
# ============================================
# Reduce sample sizes for faster/cheaper runs
SAMPLE_SIZE=50

# DSPy optimizer trials (reduce to save API costs)
DSPY_OPTIMIZER_TRIALS=10

# Max retries for Instructor validation
INSTRUCTOR_MAX_RETRIES=3

# ============================================
# Paths
# ============================================
DATA_DIR=./data
NOTEBOOK_DIR=./notebooks
